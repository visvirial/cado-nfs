name = c270

# Measured for RSA-270 on an A100 80 GB, with the polynomial of 2026-09:
# about 0.37 s per special-q at q = 1e9.
# A = 31 reaches 57% more relations per second at q = 1e9 but needs a special-q
# range three times as long, and the two tie over the whole range.  qmin = 2e9
# costs 3% less than 1e9, since low special-q create more duplicates later.
# The relation target is that of params.c260, which has the same large prime
# bounds, and it has not been checked by a filtering run; the duplicate model
# of scripts/glas-dupsim.py points to about 3.8e10 raw relations.

tasks.polyselect.degree = 6
tasks.polyselect.P = 10000000
tasks.polyselect.admax = 1e8
tasks.polyselect.adrange = 5e3
tasks.polyselect.incr = 60
tasks.polyselect.nq = 1296 # this is 6^4
tasks.polyselect.nrkeep = 200
tasks.wutimeout = 24000

tasks.lim0 = 2147483648
tasks.lim1 = 2147483648
tasks.lpb0 = 37
tasks.lpb1 = 39
tasks.sieve.mfb0 = 74
tasks.sieve.mfb1 = 117
tasks.sieve.ncurves0 = 50
tasks.sieve.ncurves1 = 35
tasks.A = 33
tasks.sieve.sqside = 1
tasks.qmin = 2000000000

tasks.sieve.fill_bands = 2

tasks.sieve.host_mr = 1

tasks.sieve.rels_wanted = 33734000000

tasks.sieve.qrange = 30000
tasks.sieve.wutimeout = 7200
tasks.sieve.maxtimedout = 1000000
tasks.sieve.maxfailed = 1000000

tasks.filter.purge.keep = 160
tasks.filter.target_density = 150.0

tasks.linalg.bwc.interleaving = 0
tasks.linalg.m = 64
tasks.linalg.n = 64

tasks.linalg.characters.nchar = 50
