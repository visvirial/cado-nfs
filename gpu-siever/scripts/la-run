#!/usr/bin/env bash
# Block Wiedemann on a GPU cluster, run by hand outside cadofactor: start it,
# follow it, stop it, and keep its checkpoints in bounds. Runs on the first
# host of the cluster; the work directory must be on the same path on every
# host (bwc.pl writes it from rank 0, the ranks read the matrix cache there).
#
#   la-run start     start (or resume) bwc.pl :complete in the background
#   la-run status    step, iteration, ms per iteration, end time (JST), disk,
#                    and the node of every grid cell
#   la-run stop      stop bwc.pl and every rank on every host
#   la-run prune     delete the V and S files once W is written
#
# Settings come from $LA_CONF (default ./la.conf), a shell file:
#
#   LA_BUILD=/opt/cado-la          MPI build tree of cado-nfs with the CUDA plugins
#   LA_MATRIX=/data/c270.sparse.bin
#   LA_WDIR=/data/bwc
#   LA_HOSTS=node1,node2,node3,node4
#   LA_GPUS=8                      GPUs (= ranks) per host
#   LA_GRID=8x4                    LA_GPUS x hosts, see bwc-gpu (a column on one host)
#   LA_MN=256                      m = n
#   LA_INTERVAL=16384              iterations between checkpoints (even)
#   LA_EXTRA="..."                 more bwc.pl arguments
#   export NCCL_IB_HCA=... NCCL_SOCKET_IFNAME=... BWC_MPI_EXTRA="--mca btl_tcp_if_include ..."
#
# At the end <LA_WDIR>/W (a link to W.sols0-64) is the kernel cadofactor wants:
# copy it with cp -L to <cado workdir>/<name>.bwc/W and run cado-nfs.py again
# with tasks.linalg.bwc.execbin=bwc-external (see that script).
#
# Restarting after a crash is `la-run stop; la-run start`: bwc.pl :complete
# skips what is done and Krylov and mksol go on from their last checkpoint.
set -Eeuo pipefail
here=$(dirname "$(readlink -f "$0")")
conf=${LA_CONF:-./la.conf}
# shellcheck disable=SC1090
. "$conf"
: "${LA_BUILD:?}" "${LA_MATRIX:?}" "${LA_WDIR:?}" "${LA_HOSTS:?}"
LA_GPUS=${LA_GPUS:-8}; LA_MN=${LA_MN:-256}; LA_INTERVAL=${LA_INTERVAL:-16384}
nh=$(tr ',' '\n' <<< "$LA_HOSTS" | sed '/^$/d' | wc -l)
LA_GRID=${LA_GRID:-${LA_GPUS}x$nh}
log=$LA_WDIR/la.log
pidf=$LA_WDIR/la.pid

running() { [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; }

start() {
  running && { echo "already running, pid $(cat "$pidf")"; exit 1; }
  mkdir -p "$LA_WDIR"
  # the matrix (with its .rw.bin and .cw.bin) need only be on this host: the
  # ranks that can read it read it and send the rows; but every host writes
  # the cache of its own ranks in a directory next to the matrix path, and
  # runs in the work directory
  for h in $(tr ',' ' ' <<< "$LA_HOSTS"); do
    if [ "$h" = "$(hostname)" ] || [ "$h" = localhost ]; then mkdir -p "$(dirname "$LA_MATRIX")"; continue; fi
    ssh -o BatchMode=yes "$h" "mkdir -p '$(dirname "$LA_MATRIX")' '$LA_WDIR'" || { echo "cannot reach $h"; exit 1; }
  done
  export BWC_LA_BUILD=$LA_BUILD BWC_MPI=$LA_GRID BWC_HOSTS=$LA_HOSTS
  export BWC_RANKS_PER_HOST=$LA_GPUS BWC_INTERVAL=$LA_INTERVAL BWC_EXTRA="${LA_EXTRA:-}"
  export SPMV_GF2_NGPU=1 SPMV_GF2_LAYOUT=${SPMV_GF2_LAYOUT:-packed}
  export BWC_NCCL_CHUNK_MB=${BWC_NCCL_CHUNK_MB:-1024}
  echo "=== start $(date '+%F %T %Z') grid $LA_GRID hosts $LA_HOSTS" >> "$log"
  setsid nohup "$here/bwc-gpu" :complete matrix="$LA_MATRIX" wdir="$LA_WDIR" \
      m="$LA_MN" n="$LA_MN" nullspace=left prime=2 >> "$log" 2>&1 < /dev/null &
  echo $! > "$pidf"
  echo "started, pid $!, log $log"
}

stop() {
  if running; then kill -TERM -- -"$(cat "$pidf")" 2>/dev/null || true; fi
  for h in $(tr ',' ' ' <<< "$LA_HOSTS"); do
    # the ranks: every program of the build tree, on every host
    if [ "$h" = "$(hostname)" ] || [ "$h" = localhost ]; then
      pkill -TERM -f "^$LA_BUILD/linalg/bwc/" || true; sleep 5; pkill -KILL -f "^$LA_BUILD/linalg/bwc/" || true; continue; fi
    ssh -o BatchMode=yes "$h" "pkill -TERM -f '^$LA_BUILD/linalg/bwc/' ; sleep 5; pkill -KILL -f '^$LA_BUILD/linalg/bwc/'" 2>/dev/null || true
  done
  rm -f "$pidf"; echo "=== stop $(date '+%F %T %Z')" >> "$log"; echo stopped
}

status() {
  if running; then echo "running (pid $(cat "$pidf"))"; else echo "NOT running"; fi
  [ -f "$log" ] || exit 0
  # the task bwc.pl is in, its last epoch line, and the last iteration it announced
  local ep it ms end
  echo "task: $(sed -n 's/^## Entering task: //p' "$log" | tail -1)"
  ep=$(grep -E '^(gkrylov|gmksol) epoch' "$log" | tail -1 || true)
  if [ -n "$ep" ]; then
    it=$(sed 's/.* epoch \([0-9]*\):.*/\1/' <<< "$ep"); ms=$(sed 's/.*iter \([0-9.]*\) ms.*/\1/' <<< "$ep")
    end=$(sed -n 's/^## \(krylov\|mksol\) max iteration is \([0-9]*\).*/\2/p' "$log" | tail -1)
    echo "last epoch: $ep (log written $(date -r "$log" '+%F %T %Z'))"
    if [ -n "$end" ]; then
      python3 - "$it" "$end" "$ms" <<'EOF2'
import sys, datetime
it, end, ms = int(sys.argv[1]), int(sys.argv[2]), float(sys.argv[3])
left = max(end - it, 0) * ms / 1e3
jst = datetime.timezone(datetime.timedelta(hours=9))
eta = datetime.datetime.now(jst) + datetime.timedelta(seconds=left)
print(f"iteration {it} of {end} ({100*it/end:.2f} %), {left/86400:.2f} days left at {ms:.1f} ms/iter, this task ends {eta:%Y-%m-%d %H:%M} JST")
EOF2
    fi
  fi
  # the node of every grid cell, printed by the first program of each run
  grep -A$(( ${LA_GRID%x*} )) -E '^[0-9]+ nodes' "$log" | tail -$(( ${LA_GRID%x*} + 1 )) || true
  grep -iE 'error|abort|failed|out of memory|signal' "$log" | tail -3 || true
  df -h "$LA_WDIR" | tail -1
  ls "$LA_WDIR" | grep -cE '^V[0-9]+-[0-9]+\.[0-9]+$' | sed 's/^/V checkpoints: /'
}

# Krylov writes V<ys>.<iter> at every checkpoint (N * 64 / 8 bytes per file of 64
# columns: 4 x 12.6 GB at 1.57e9 rows), and mksol starts each of its blocks from
# the V files of that block's first iteration, then writes one S file per block
# that gather sums: none of them may go before gather has run (2026-11-07: a
# prune during Krylov left mksol without its V files and no kernel). prune
# therefore only deletes them once W exists.
prune() {
  cd "$LA_WDIR"
  [ -e W ] || { echo "no W yet: mksol and gather still need every V and S file"; exit 1; }
  ls | grep -E '^[VS][0-9a-z.-]*\.[0-9]+(-[0-9]+)?$' | grep -vE '^V[0-9]+-[0-9]+\.0$' |
    while read -r f; do rm -f -- "$f"; echo "pruned $f"; done
}

case "${1:-}" in
  start) start ;; stop) stop ;; status) status ;; prune) prune ;;
  *) sed -n '2,/^set -E/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 1 ;;
esac
