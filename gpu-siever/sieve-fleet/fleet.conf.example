SERVER=https://cado-nfs.example.org:8270   # what the clients dial: c270-sieve-server's PUBLIC_NAME and PORT
CERTSHA1=0000000000000000000000000000000000000000   # the --certsha1 the server prints
SERVER_SSH=        # resubmit-lost.sh: how to ssh to the server (user@host), and its WORKDIR
SERVER_WORKDIR=
CAP=40           # dollars per million special-q, for every provider: an RTX 5090 at 0.72 dollars an hour is 40
MAXHOSTS=10
GPUS=RTX_5090,RTX_4090,RTX_3090   # GPU models to rent, of those in SPQ_TABLE (env.sh)
VAST_DISK=50     # GB of disk per Vast host; its price counts in the cap
MINCPU=16        # effective cores of an offer; glas runs 8 threads, and fewer cores left it host-bound
MIN_DAYS=3       # skip offers whose machine leaves the market (end_date) within this many days
VERIFIED=true    # false: also rent unverified machines
BID=0            # 1: also rent interruptible offers, when cheaper per special-q
BID_MARGIN=0.05  # bid this much above the offer's minimum bid
BID_MAX=         # at most this many interruptible hosts at a time (empty: no limit). On 2026-11-06 interruptible
                 # 5090s lived 21 min (median) whatever the bid, too short for a 25 min work unit: 56 $/Msq
MINCREDIT=30     # below this Vast.ai credit, destroy everything
STOP=0           # 1: destroy every host and exit
# host/client.sh: make the factor base on the host with makefb while downloading it from the
# server, and keep whichever ends first (far from the server, the download takes hours); the
# poly file name and the makefb arguments of the server's c270.makefb.stdout.1, and the output
MAKEFB="c270.poly -lim 2147483648 -maxbits 17 -side 1"
MAKEFB_OUT=c270.roots1.gz
SALAD_ORG=       # salad.sh: the SaladCloud organization and project, and each container's
SALAD_PROJECT=   # vCPUs and memory in MB (glas runs 8 threads and takes about 3.5 GB)
SALAD_CPU=16
SALAD_MEMORY=24576
CLORE_MAXHOSTS=10   # clore-fleet.sh
CLORE_MINREL=0.98   # Clore server reliability
CLORE_MINBAL=2   # below this Clore balance, cancel every order
CLORE_STOP=0     # 1: cancel every Clore order and exit (STOP=1 does too)
SALAD_TIERS="batch low"   # salad-fleet.sh: priorities, cheapest first, one container group each
SALAD_GROUP=c270-sv       # the group of each tier is SALAD_GROUP-<priority>
SALAD_HEADROOM=5          # replicas a tier asks for beyond those it has
SALAD_REPLICAS=           # all the tiers together; empty: the organization's quota
SALAD_FIXED=              # fixed replicas per tier, from the quota first, e.g. "medium=80 low=0". On 2026-11-06
                          # medium returned 0.87 results per instance-hour, low 0.30 (interrupted before a 3090 work unit ends)
SALAD_STOP=0              # 1: stop and delete every Salad group (STOP=1 does too)
