SERVER=https://cado-nfs.example.org:8270   # what the clients dial, as c270-polyselect-server's PUBLIC_NAME and PORT
CERTSHA1=0000000000000000000000000000000000000000   # the --certsha1 the server prints
SERVER_SSH=        # resubmit-lost.sh: how to ssh to the server (user@host), and its WORKDIR
SERVER_WORKDIR=
CAP=0.6          # dollars per hour per ad/s; an RTX 3090 at 0.30 dollars an hour is 0.6
MAXHOSTS=60
MINKEEP=6        # idle hosts kept for root optimization
BID=0            # 1: also rent interruptible offers, when cheaper per ad/s
BID_MARGIN=0.05  # bid this much above the offer's minimum bid
MINCREDIT=30     # below this Vast.ai credit, destroy everything
STOP=0           # 1: destroy every host and exit
SALAD_ORG=       # for salad.sh: the SaladCloud organization and project
SALAD_PROJECT=
CLORE_CAP=0.5    # clore-fleet.sh: dollars per hour per ad/s
CLORE_MAXHOSTS=60
CLORE_MINREL=0.98   # Clore server reliability
CLORE_MINBAL=2   # below this Clore balance, cancel every order
CLORE_MINKEEP=0
CLORE_STOP=0     # 1: cancel every Clore order and exit (STOP=1 does too)
